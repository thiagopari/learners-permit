# The evaluation-sweep image, packaged from a GPU VM where `cloud/vm.sh setup` passed: the same GR00T N1.7 server,
# RoboLab on Isaac Sim 5.0 (with the background fix) and control plane, at the same paths, with GR00T's weights
# baked in, so the job needs no Hugging Face token and no hour of installs. cloud/job/Dockerfile builds the same
# stack from scratch instead.
#
# Built on the VM by cloud/job/build_on_vm.sh, with /home/permit as the build context.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive OMNI_KIT_ACCEPT_EULA=Y ACCEPT_EULA=Y PRIVACY_CONSENT=Y \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=all \
    HOME=/home/permit PATH=/home/permit/.local/bin:$PATH LP_PREFIX=/home/permit HF_HUB_OFFLINE=1

# The system libraries setup_vm.sh installs: Isaac Sim needs the GL/X ones (libGLU above all) and Vulkan.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git ffmpeg jq python3 python3-venv iproute2 procps vulkan-tools libvulkan1 \
        libglu1-mesa libegl1 libgl1 libxt6 libxrender1 libxi6 libsm6 libxrandr2 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/* \
    && (userdel -r ubuntu 2> /dev/null || true) && useradd -m -u 1001 -s /bin/bash permit

COPY --chown=1001:1001 .local /home/permit/.local
COPY --chown=1001:1001 .cache/huggingface/hub/models--nvidia--GR00T-N1.7-DROID \
    /home/permit/.cache/huggingface/hub/models--nvidia--GR00T-N1.7-DROID
# GR00T N1.7's backbone IS Cosmos-Reason2-2B: the policy server loads it at start. The first job (Oct 28) left it out
# and died offline with "couldn't connect to huggingface.co ... couldn't find them in the cached files".
COPY --chown=1001:1001 .cache/huggingface/hub/models--nvidia--Cosmos-Reason2-2B \
    /home/permit/.cache/huggingface/hub/models--nvidia--Cosmos-Reason2-2B
COPY --chown=1001:1001 Isaac-GR00T /home/permit/Isaac-GR00T
COPY --chown=1001:1001 RoboLab /home/permit/RoboLab
COPY --chown=1001:1001 learners-permit /home/permit/learners-permit
COPY --chown=1001:1001 lp-versions.txt /home/permit/versions.txt

USER permit
WORKDIR /home/permit
ENTRYPOINT ["bash", "/home/permit/learners-permit/cloud/job/entrypoint.sh"]
