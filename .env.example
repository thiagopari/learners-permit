# Hugging Face Read token, after accepting the gate on nvidia/Cosmos-Reason2-2B
HF_TOKEN=
# Nebius AI Cloud project for the GPU VM and jobs: learners-permit, uk-south2
NEBIUS_PROJECT_ID=project-e05q4359ln00h850sa05y3

